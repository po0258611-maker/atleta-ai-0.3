rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /exerciseLogs/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /progression/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Subscription state is server-authoritative. Clients may read it,
      // but cannot grant, extend, cancel, or otherwise modify billing state.
      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /measurements/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
